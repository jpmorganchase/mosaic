{
  "name": "@jpmorganchase/mosaic-schemas",
  "version": "1.0.0-beta.99",
  "author": "",
  "description": "Mosaic Schemas",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./commitMessage": {
      "types": "./dist/commitMessage.d.ts",
      "import": "./dist/commitMessage.js",
      "default": "./dist/commitMessage.js"
    },
    "./routePath": {
      "types": "./dist/routePath.d.ts",
      "import": "./dist/routePath.js",
      "default": "./dist/routePath.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/mosaic.git",
    "directory": "packages/schemas"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -fr dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "zod": "^4.6.7",
    "zod-validation-error": "^4.0.2"
  }
}
