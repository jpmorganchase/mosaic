# Loaded by Next.js in every environment (development, production, test).
# Environment-specific files layer on top of it:
#   .env.development        - `next dev` only (committed dev defaults)
#   .env.production         - `next build` / `next start` (not committed here)
#   .env.local, .env.*.local - personal overrides and real secrets (gitignored)
# Never put secrets in this file.
NEXT_PUBLIC_ENABLE_LOGIN=false
SITE_URL=https://mosaic-mosaic-dev-team.vercel.app/
# Only read in the snapshot modes (MOSAIC_MODE=snapshot-file|snapshot-s3).
MOSAIC_SNAPSHOT_DIR=snapshots/latest
