# Local development overrides. See `.env` for defaults and `.env.prod`
# for production overrides. This file is gitignored — anything sensitive
# (real secrets, OAuth client IDs, etc.) lives only here.

# --- Mosaic mode + content source ---
MOSAIC_MODE=active
MOSAIC_ACTIVE_MODE_URL=http://localhost:8080
MOSAIC_SNAPSHOT_DIR=snapshots/latest

# --- Image optimisation (read by site-components/Image) ---
NEXT_PUBLIC_OPTIMIZE_IMAGES=false

# --- Canonical origin used as `metadataBase` in `app/layout.tsx`.
# Drives:
#   - relative og:image / twitter:image URLs in `generateMetadata`,
#   - <loc> entries in `app/sitemap.ts` (served at /sitemap.xml),
#   - the Sitemap: line in `app/robots.ts` (served at /robots.txt).
# Set this per environment in production (preview branches, prod, etc.).
# The leading `https://` matters — it's parsed with `new URL(...)`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Content-cache loader behaviour (WS-9) ---
# Bypass the cross-request `unstable_cache` layer in
# `mosaic-site-middleware/cachedLoaders.ts` while iterating locally on
# snapshot files. Without this, edits to files in `snapshots/latest/`
# won't appear in the running dev server until a revalidate is fired
# (either via `POST /api/revalidate` or by restarting `next dev`).
# Comment out (or set to `false`) to exercise the cache path — useful
# when verifying that the revalidate webhook works end-to-end, or to
# get the real production timing locally.
MOSAIC_DISABLE_LOADER_CACHE=true

# Shared secret consumed by `app/api/revalidate/route.ts`. Anything POSTing
# to that endpoint must send the same value in the
# `x-mosaic-revalidate-secret` header (or `Authorization: Bearer ...`).
# The CLI's `serve` command reads the matching `MOSAIC_REVALIDATE_SECRET`
# from its own process env (see `packages/site/package.json` → `serve`
# script) so cache-busting on source updates happens automatically.
# Pick something non-trivial in real deployments.
MOSAIC_REVALIDATE_SECRET=local-dev-not-a-secret

# --- Auth.js v5 ---
# Required even in dev. Generate a real value for any non-local
# deployment with: openssl rand -base64 32
# Note: Auth.js v5 does NOT need NEXTAUTH_URL — it uses `trustHost: true`
# (see src/auth.ts) and infers the origin from request headers.
AUTH_SECRET=local-dev-auth-secret-not-for-production
# --- Dev-only fake auth (testing the editor without a GitHub OAuth app) ---
# Set both to 'true' to enable a Credentials provider that auto-accepts any
# sign-in. Gated on NODE_ENV !== 'production' in src/auth.ts.
NEXT_PUBLIC_ENABLE_LOGIN=true
MOSAIC_DEV_FAKE_AUTH=true

# --- Dev-only capability-gate bypass (running the editor against local
# content). This repo's dev config serves docs via source-local-folder,
# which is correctly non-writable; without this flag the editor would
# be hidden on every page (and the editor e2e tests would fail). Gated
# on NODE_ENV !== 'production' in src/app/[...route]/page.tsx and logs
# a boot warning when active. Do NOT set this in production.
MOSAIC_DEV_BYPASS_CAPABILITY_GATE=true

