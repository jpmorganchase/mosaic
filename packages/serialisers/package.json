{
  "name": "@jpmorganchase/mosaic-serialisers",
  "version": "0.1.0-beta.98",
  "author": "",
  "description": "Mosaic serializers for core file system",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "import": "./dist/frontmatter.js",
      "node": "./dist/frontmatter.js",
      "default": "./dist/frontmatter.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "import": "./dist/mdx.js",
      "node": "./dist/mdx.js",
      "default": "./dist/index.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "node": "./dist/json.js"
    },
    "./md": {
      "types": "./dist/md.d.ts",
      "import": "./dist/md.js",
      "node": "./dist/md.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -fr dist",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/mosaic.git",
    "directory": "packages/serialisers"
  },
  "dependencies": {
    "@jpmorganchase/mosaic-types": "^0.1.0-beta.98",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
