{
  "name": "@jpmorganchase/mosaic-site-components",
  "version": "0.1.0-beta.98",
  "license": "Apache-2.0",
  "description": "Mosaic - Site components",
  "repository": {
    "type": "git",
    "url": "git@github.com:jpmorganchase/mosaic.git",
    "directory": "packages/site-components"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    "./index.css": "./dist/index.css",
    ".": {
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "concurrently \"yarn:build:*\"",
    "build:bundle": "node ../../scripts/bundle.mjs",
    "build:types": "tsc",
    "clean": "npx del-cli 'dist/**' && find . -type d -empty -delete",
    "lint": "eslint .",
    "dev": "node ../../scripts/bundle.mjs watch"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "concurrently": "^7.1.0",
    "del-cli": "^6.0.0",
    "next-router-mock": "^0.9.13",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@jpmorganchase/mosaic-components": "^0.1.0-beta.98",
    "@jpmorganchase/mosaic-content-editor-plugin": "^0.1.0-beta.98",
    "@jpmorganchase/mosaic-open-api-component": "^0.1.0-beta.98",
    "@jpmorganchase/mosaic-store": "^0.1.0-beta.98",
    "@jpmorganchase/mosaic-theme": "^0.1.0-beta.98",
    "@salt-ds/core": "^1.63.0",
    "@vanilla-extract/css": "^1.6.0",
    "clsx": "^2.0.0",
    "fuse.js": "^6.6.2",
    "lodash-es": "^4.17.23",
    "next": "^16.2.6",
    "next-mdx-remote-client": "^1.0.3",
    "swr": "^2.1.2"
  },
  "peerDependencies": {
    "@types/react": "^18.3.12",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
