{
  "name": "@jpmorganchase/mosaic-site-components",
  "version": "1.0.0-beta.99",
  "license": "Apache-2.0",
  "description": "Mosaic - Site components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpmorganchase/mosaic.git",
    "directory": "packages/site-components"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    "./index.css": "./dist/index.css",
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "node": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./auth/next-auth": {
      "types": "./dist/auth/next-auth.d.ts",
      "import": "./dist/auth/next-auth.js",
      "node": "./dist/auth/next-auth.js",
      "default": "./dist/auth/next-auth.js"
    },
    "./SearchProvider": {
      "types": "./dist/SearchProvider/index.d.ts",
      "import": "./dist/SearchProvider/index.js",
      "node": "./dist/SearchProvider/index.js",
      "default": "./dist/SearchProvider/index.js"
    },
    ".": {
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "concurrently \"yarn:build:*\"",
    "build:bundle": "node ../../scripts/bundle.mjs",
    "build:types": "tsc",
    "clean": "npx del-cli 'dist/**' && find . -type d -empty -delete",
    "lint": "eslint .",
    "dev": "node ../../scripts/bundle.mjs watch"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "concurrently": "^7.1.0",
    "del-cli": "^6.0.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-router-mock": "^0.9.13",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@jpmorganchase/mosaic-components": "workspace:^",
    "@jpmorganchase/mosaic-content-editor-plugin": "workspace:^",
    "@jpmorganchase/mosaic-site-middleware": "workspace:^",
    "@jpmorganchase/mosaic-store": "workspace:^",
    "@jpmorganchase/mosaic-theme": "workspace:^",
    "@jpmorganchase/mosaic-types": "workspace:^",
    "@salt-ds/core": "^1.73.0",
    "@vanilla-extract/css": "^1.6.0",
    "clsx": "^2.0.0",
    "lodash-es": "^4.17.23",
    "next-mdx-remote-client": "^2.1.12"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "next": "^16.4.5",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    }
  }
}
