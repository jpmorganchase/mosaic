{
  "name": "@jpmorganchase/mosaic-store",
  "description": "Mosaic - Store for site configuration",
  "version": "1.0.0-beta.99",
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:jpmorganchase/mosaic.git",
    "directory": "packages/store"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "concurrently \"yarn:build:*\"",
    "build:bundle": "node ../../scripts/bundle.mjs",
    "build:types": "tsc",
    "clean": "npx del-cli 'dist/**' && find . -type d -empty -delete",
    "lint": "eslint .",
    "dev": "node ../../scripts/bundle.mjs watch"
  },
  "devDependencies": {
    "concurrently": "^7.1.0",
    "del-cli": "^6.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@jpmorganchase/mosaic-types": "^1.0.0-beta.99",
    "zustand": "^4.1.1"
  },
  "peerDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
