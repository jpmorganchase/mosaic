{
  "name": "@jpmorganchase/mosaic-content-editor-plugin",
  "description": "Mosaic - In Browser content editing plugin",
  "version": "0.1.0-beta.98",
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git@github.com:jpmorganchase/mosaic.git",
    "directory": "packages/content-editor-plugin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    "./index.css": "./dist/index.css",
    ".": {
      "style": "./dist/index.css",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "concurrently \"yarn:build:*\"",
    "build:bundle": "node ../../scripts/bundle.mjs",
    "build:types": "tsc",
    "clean": "npx del-cli 'dist/**' && find . -type d -empty -delete",
    "lint": "eslint .",
    "dev": "node ../../scripts/bundle.mjs watch"
  },
  "devDependencies": {
    "concurrently": "^7.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.6",
    "@jpmorganchase/mosaic-components": "^0.1.0-beta.98",
    "@jpmorganchase/mosaic-theme": "^0.1.0-beta.98",
    "@lexical/code": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/markdown": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/table": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@salt-ds/core": "^1.56.0",
    "@salt-ds/icons": "^1.17.1",
    "@salt-ds/theme": "^1.39.0",
    "@vanilla-extract/css": "^1.6.0",
    "clsx": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lexical": "^0.44.0",
    "lodash-es": "^4.17.23",
    "react-split": "^2.0.14",
    "yup": "^0.32.9"
  },
  "peerDependencies": {
    "@types/react": "^18.3.12 || ^19.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "next-mdx-remote-client": "^1.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
