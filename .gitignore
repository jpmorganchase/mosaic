node_modules

**/.tmp/
**/dist/
**/build/
**/.next/
next-env.d.ts
**/out/

# Dependencies
**/node_modules

.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Identify the release and plugin bundles as binary content.
# This way Git won't bother showing massive diffs when each time you subsequently add or update them
/.yarn/releases/** binary
/.yarn/plugins/** binary

# Production
**/dist-labs/
**/.tmp/**
tsconfig.tsbuildinfo

# Deployment
packages/site/public/images
# PublicAssetsPlugin output (regenerated on every Mosaic build, never edit
# by hand). sitemap.xml is handled by Next.js's App Router app/sitemap.ts
# now, so it's never written to public/ — search-data.json is the only one
# that still lands here.
packages/site/public/search-data.json

# Test Results
coverage
sonar-reports
test-report.xml
junit.xml
test-results.json
test-results

# Misc
.DS_Store
.idea
.vscode
.db
*.iml
thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Turbo Repo
.turbo

# Playwright CLI session logs (local-only browser console capture from the
# playwright-cli skill — never useful in version control).
.playwright-cli/

# Mosaic static-export route-handler backups (scripts/static-export-route-stubs.mjs)
packages/site/src/app/api/**/route.ts.bak
