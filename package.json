{
  "name": "@jpmorganchase/mosaic",
  "version": "0.1.0-beta.2",
  "author": "",
  "description": "",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build:site": "turbo run build --filter=@jpmorganchase/mosaic-site",
    "build": "turbo run build --filter=!@jpmorganchase/mosaic-site",
    "clean": "turbo run clean",
    "deploy:site": "turbo run deploy --filter=@jpmorganchase/mosaic-site",
    "deploy": "yarn build:site",
    "dev": "turbo run dev",
    "e2e:codegen": "turbo run e2e:codegen --filter=@jpmorganchase/mosaic-site",
    "e2e:setup": "npx playwright install",
    "e2e": "turbo run e2e --filter=@jpmorganchase/mosaic-site",
    "gen:snapshot": "turbo run gen:snapshot --filter=@jpmorganchase/mosaic-site",
    "gen": "turbo run gen:site gen:snapshot --filter=//",
    "lint": "turbo run lint",
    "mosaic": "node ./packages/cli/dist/index.js",
    "prepare": "husky install",
    "prettier:ci": "prettier --check .",
    "prettier": "prettier --write .",
    "serve:snapshot:file": "turbo run serve:snapshot:file --filter=@jpmorganchase/mosaic-site",
    "serve:snapshot:s3": "turbo run serve:snapshot:s3 --filter=@jpmorganchase/mosaic-site",
    "serve": "turbo run serve --filter=@jpmorganchase/mosaic-site",
    "start": "turbo run start --filter=@jpmorganchase/mosaic-site",
    "test:client": "vitest --project=client",
    "test:server": "vitest --project=server",
    "test": "vitest --coverage",
    "docker:volume": "docker container create --name docs-copy -v docs:/docs mosaic-fs && docker cp ./docs docs-copy:/ && docker rm docs-copy",
    "docker:network": "docker network create mosaic-net"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jpmorganchase/mosaic.git"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.6",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.15",
    "@vitest/coverage-istanbul": "^4.0.0",
    "eslint": "^10.4.0",
    "eslint-config-airbnb-extended": "^2.3.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "patch:eslint-plugin-react@npm%3A7.37.5#~/.yarn/patches/eslint-plugin-react-npm-7.37.5-d03f6b6543.patch",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resize-observer-polyfill": "1.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "turbo": "^2.9.14"
  },
  "resolutions": {
    "@types/mdast": "^4.0.0",
    "@types/react": "^19.0.0",
    "commander": "^9.4.0",
    "esbuild": "0.25.0",
    "json5": "^1.0.2",
    "postcss": "^8.5.10",
    "prismjs": "1.30.0",
    "eslint-plugin-react@npm:^7.37.0": "patch:eslint-plugin-react@npm%3A7.37.5#~/.yarn/patches/eslint-plugin-react-npm-7.37.5-d03f6b6543.patch"
  },
  "lint-staged": {
    "*": [
      "prettier --write"
    ]
  },
  "packageExtensions": {
    "eslint-config-airbnb-extended@*": {
      "peerDependencies": {
        "eslint": "^9.0.0 || ^10.0.0"
      }
    },
    "eslint-plugin-react@*": {
      "peerDependencies": {
        "eslint": "^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9.7 || ^10"
      }
    }
  },
  "packageManager": "yarn@4.10.3"
}
